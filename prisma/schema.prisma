generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  STAFF
  SUPERVISOR
}

enum TransferStatus {
  PENDING
  RECEIVED
}

enum DOStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum GatePassStatus {
  DRAFT
  AWAITING_CUSTOMER
  CUSTOMER_SUBMITTED
  WAREHOUSE_ACKNOWLEDGED
  PREPARING
  READY_FOR_PICKUP
  CHECKED_IN
  LOADING
  CHECKED_OUT
  COMPLETED
  EXPIRED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum GatePassActorType {
  INTERNAL_USER
  EXTERNAL_CUSTOMER
  SYSTEM
}

enum PalletTransferStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PalletMovementType {
  OPENING_BALANCE
  ISSUE_OUT
  RETURN_IN
  TRANSFER
  DAMAGE_RETURN
  LOST_WRITE_OFF
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum PalletCondition {
  USABLE
  DAMAGED
  LOST
}

enum PhysicalPalletStatus {
  IN_WAREHOUSE
  WITH_CUSTOMER
  RETURNED
  DAMAGED
  LOST
}

enum PalletCustodianKind {
  SYSTEM_OPENING
  WAREHOUSE_USABLE
  WAREHOUSE_DAMAGED
  CUSTOMER
  TRANSPORTER
  WRITTEN_OFF
}

enum ReturnReason {
  DAMAGE
  WRONG_PO
  DELIVERY_FAIL
}

enum ReturnStatus {
  QUARANTINE
  SCRAP
  REPACKED
  RESTOCKED
}

model User {
  id                         String                      @id @default(uuid())
  name                       String
  email                      String                      @unique
  password                   String
  role                       Role                        @default(STAFF)
  branchId                   String?
  unitId                     String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  modules                    String[]                    @default([])
  googleEmail                String?
  signatureUrl               String?
  signatureUpdatedAt         DateTime?
  dailyReports               DailyReport[]               @relation("DailyReportCreator")
  createdDOs                 DistributionOrder[]         @relation("DOCreator")
  distributionTrackingEvents DistributionTrackingEvent[] @relation("DistributionTrackingActor")
  receivedTransfers          ProductionTransfer[]        @relation("TransferReceiver")

  // Handover Relations
  createdHandovers  ProductionHandover[] @relation("HandoverCreator")
  receivedHandovers ProductionHandover[] @relation("HandoverReceiver")

  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  unit                   Unit?                   @relation(fields: [unitId], references: [id])
  openingStocks          WarehouseOpeningStock[] @relation("OpeningStockSetter")
  auditLogs              AuditLog[]

  // Gatepass & Pallet relations
  gatePassesCreated       WarehouseGatePass[]     @relation("WarehouseGatePassCreator")
  gatePassStatusEvents    GatePassStatusEvent[]   @relation("GatePassStatusActor")
  gatePassDOLinks         GatePassDeliveryOrder[] @relation("GatePassDOLinker")
  palletTransfersCreated  PalletTransfer[]        @relation("PalletTransferCreator")
  palletTransfersVerified PalletTransfer[]        @relation("PalletTransferVerifier")
  palletTransfersPosted   PalletTransfer[]        @relation("PalletTransferPoster")
  palletTransfersReversed PalletTransfer[]        @relation("PalletTransferReverser")
  createdPalletMovements  PalletMovement[]        @relation("PalletMovementCreator")
  physicalPalletEvents    PhysicalPalletEvent[]

  // Sales Ordering relations
  uploadedSalesDocs      SalesDocumentIntake[]   @relation("SalesDocumentUploader")
  reviewedSalesDocs      SalesDocumentIntake[]   @relation("SalesDocumentReviewer")
  createdSalesOrders     SalesOrder[]            @relation("SalesOrderCreator")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]
  users     User[]
}

model Unit {
  id        String     @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    Branch     @relation(fields: [branchId], references: [id])
  users     User[]
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------------------------
// PRODUCTION OPERATIONS
// ---------------------------------------------------------------------------------------------

model TransferIn {
  id           String           @id @default(uuid())
  receiveDate  DateTime         @db.Date
  receiveTime  String
  shift        String           @default("AM")
  doNumber     String
  receiverName String
  createdAt    DateTime         @default(now())
  items        TransferInItem[]
}

model TransferInItem {
  id           String     @id @default(uuid())
  transferInId String
  category     String
  batchNo      String
  bags         Int
  mult         Int
  transferIn   TransferIn @relation(fields: [transferInId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                  String               @id @default(uuid())
  date                DateTime             @db.Date
  shift               String
  line                String
  preparedBy          String
  verifiedBy          String
  remarks             String?
  createdAt           DateTime             @default(now())
  status              String               @default("PENDING")
  noProduction        Boolean              @default(false)
  preparedSignature   String?
  verifiedSignature   String?
  time                String?
  reportTime          String?
  approvedAt          DateTime?
  createdById         String?
  totalManpower       Int?
  maxTotalManpower    Int?
  breakdowns          BreakdownLog[]
  createdBy           User?                @relation("DailyReportCreator", fields: [createdById], references: [id])
  inventory           InventoryLog[]
  productions         ProductionOutput[]
  productionTransfers ProductionTransfer[]
  productionHandovers ProductionHandover[]
  rejects             RejectLog[]
  holds               ProductionHoldItem[]

  @@index([status, date])
}

model ProductionHoldItem {
  id         String      @id @default(uuid())
  reportId   String
  sectionKey String
  batchNo    String
  qty        Float
  mult       Int         @default(1)
  reason     String
  status     String      @default("PENDING") // PENDING, REJECT_BEFORE, REJECT_AFTER, REUSE, RETURN
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  resolvedAt DateTime?
  report     DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionOutput {
  id          String            @id @default(uuid())
  reportId    String
  productType String
  totalBox    Int
  batches     ProductionBatch[]
  report      DailyReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionBatch {
  id                 String           @id @default(uuid())
  productionOutputId String
  batchNo            String
  qty                Int
  type               String
  otherType          String?
  productionOutput   ProductionOutput @relation(fields: [productionOutputId], references: [id], onDelete: Cascade)
}

model RejectLog {
  id       String      @id @default(uuid())
  reportId String
  item     String
  before   Int
  after    Int
  type     String      @default("SCRAP")
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model BreakdownLog {
  id       String      @id @default(uuid())
  reportId String
  section  String
  downtime Int
  reason   String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id         String      @id @default(uuid())
  reportId   String
  sectionKey String
  type       String
  period     String?
  batchNo    String
  bags       Float
  mult       Int
  labelType  String?
  report     DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionTransfer {
  id            String         @id @default(uuid())
  dailyReportId String?
  sku           String
  batchNumber   String
  qtyProduced   Int
  status        TransferStatus @default(PENDING)
  receivedById  String?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dailyReport   DailyReport?   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  receivedBy    User?          @relation("TransferReceiver", fields: [receivedById], references: [id])
}

model ProductionHandover {
  id             String   @id @default(uuid())
  handoverNumber String   @unique
  date           DateTime

  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  productionStaffId String
  productionStaff   User    @relation("HandoverCreator", fields: [productionStaffId], references: [id])
  productionSign    String?

  warehouseStaffId String?
  warehouseStaff   User?   @relation("HandoverReceiver", fields: [warehouseStaffId], references: [id])
  warehouseSign    String?

  status    String   @default("PENDING") // PENDING, ACKNOWLEDGED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items HandoverItem[]
}

model HandoverItem {
  id               String @id @default(uuid())
  handoverId       String
  category         String
  batchNo          String
  type             String @default("Standard")
  totalProducedPcs Int

  deductions HandoverDeduction[]

  netToWarehousePcs Int

  handover ProductionHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model HandoverDeduction {
  id             String  @id @default(uuid())
  handoverItemId String
  destination    String
  qtyPcs         Int
  remarks        String?

  handoverItem HandoverItem @relation(fields: [handoverItemId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------------------------
// WAREHOUSE & LOGISTICS
// ---------------------------------------------------------------------------------------------

model InventoryBatch {
  id               String   @id @default(uuid())
  batchNumber      String
  sku              String
  totalQtyIn       Int      @default(0)
  totalQtyOut      Int      @default(0)
  availableBalance Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sku, batchNumber])
}

model DistributionOrder {
  id                 String                      @id @default(uuid())
  doNumber           String                      @unique
  distributionDate   DateTime
  destination        String
  vehicleNo          String?
  driverName         String?
  status             DOStatus                    @default(PREPARING)
  createdById        String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  sponsorshipDetails String?
  distributionMethod String
  items              DOLineItem[]
  createdBy          User                        @relation("DOCreator", fields: [createdById], references: [id])
  returns            GoodsReturnNote[]
  trackingEvents     DistributionTrackingEvent[]
  gatePassLinks      GatePassDeliveryOrder[]
  palletTransfers    PalletTransfer[]
  physicalPallets    PhysicalPallet[]            @relation("CurrentPalletDO")
  physicalPalletEvents PhysicalPalletEvent[]

  @@index([status, distributionDate])
}

model DistributionTrackingEvent {
  id                  String   @id @default(uuid())
  distributionOrderId String
  eventType           String
  latitude            Float?
  longitude           Float?
  accuracy            Float?
  locationStatus      String   @default("UNAVAILABLE")
  remarks             String?  @db.Text
  recordedById        String
  recordedAt          DateTime @default(now())

  distributionOrder DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
  recordedBy        User              @relation("DistributionTrackingActor", fields: [recordedById], references: [id])

  @@index([distributionOrderId, recordedAt])
  @@index([eventType, recordedAt])
}

model DOLineItem {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtySent             Int
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model GoodsReturnNote {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtyReturned         Int
  reason              ReturnReason
  status              ReturnStatus      @default(QUARANTINE)
  loggedAt            DateTime          @default(now())
  restockedAt         DateTime?
  restockedBy         String?
  restockedSignature  String?
  restockedReason     String?
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model WarehouseOpeningStock {
  id          String   @id @default(uuid())
  batchNumber String
  sku         String
  openingQty  Int
  month       Int
  year        Int
  setById     String
  createdAt   DateTime @default(now())
  setBy       User     @relation("OpeningStockSetter", fields: [setById], references: [id])

  @@unique([sku, batchNumber, month, year])
}

model WarehouseGatePass {
  id                      String         @id @default(uuid())
  gatePassNo              String         @unique
  status                  GatePassStatus @default(DRAFT)
  purpose                 String
  requestedPickupAt       DateTime
  pickupLocation          String
  destination             String
  customerName            String
  customerContactName     String?
  customerContactEmail    String?
  customerContactPhone    String?
  customerReference       String?
  plannedPalletQty        Int            @default(0)
  actualPalletQty         Int?
  transportCompany        String?
  driverName              String?
  driverPhone             String?
  vehicleNo               String?
  vehicleType             String?
  checkedInVehicleNo      String?
  checkedInDriverName     String?
  confirmedEta            DateTime?
  internalRemarks         String?        @db.Text
  customerRemarks         String?        @db.Text
  warehouseRemarks        String?        @db.Text
  securityRemarks         String?        @db.Text
  cancellationReason      String?        @db.Text
  rejectionReason         String?        @db.Text
  createdById             String
  customerSubmittedAt     DateTime?
  warehouseAcknowledgedAt DateTime?
  readyAt                 DateTime?
  checkedInAt             DateTime?
  loadingStartedAt        DateTime?
  loadingCompletedAt      DateTime?
  checkedOutAt            DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  createdBy          User                        @relation("WarehouseGatePassCreator", fields: [createdById], references: [id])
  items              WarehouseGatePassItem[]
  externalTokens     GatePassExternalToken[]
  verificationTokens GatePassVerificationToken[]
  statusEvents       GatePassStatusEvent[]
  deliveryOrders     GatePassDeliveryOrder[]
  palletTransfers    PalletTransfer[]
  physicalPallets    PhysicalPallet[]            @relation("CurrentPalletGatePass")
  physicalPalletEvents PhysicalPalletEvent[]

  @@index([status, requestedPickupAt])
  @@index([customerName])
  @@index([vehicleNo])
  @@index([createdById, createdAt])
}

model WarehouseGatePassItem {
  id             String  @id @default(uuid())
  gatePassId     String
  sku            String?
  description    String
  uom            String  @default("BOX")
  plannedQty     Int
  actualQty      Int?
  varianceReason String? @db.Text
  sortOrder      Int     @default(0)

  gatePass WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@index([gatePassId, sortOrder])
}

model GatePassExternalToken {
  id          String    @id @default(uuid())
  gatePassId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  gatePass WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@index([gatePassId, createdAt])
  @@index([expiresAt])
}

model GatePassVerificationToken {
  id         String    @id @default(uuid())
  gatePassId String
  publicCode String    @unique
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  gatePass WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@index([gatePassId, createdAt])
}

model GatePassStatusEvent {
  id          String            @id @default(uuid())
  gatePassId  String
  fromStatus  GatePassStatus?
  toStatus    GatePassStatus
  actorType   GatePassActorType
  actorUserId String?
  actorLabel  String?
  remarks     String?           @db.Text
  ipAddress   String?
  userAgent   String?           @db.Text
  occurredAt  DateTime          @default(now())

  gatePass  WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  actorUser User?             @relation("GatePassStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([gatePassId, occurredAt])
  @@index([actorUserId])
}

model GatePassDeliveryOrder {
  gatePassId          String
  distributionOrderId String
  isPrimary           Boolean  @default(false)
  linkedById          String
  linkedAt            DateTime @default(now())

  gatePass          WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  distributionOrder DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
  linkedBy          User              @relation("GatePassDOLinker", fields: [linkedById], references: [id])

  @@id([gatePassId, distributionOrderId])
  @@index([distributionOrderId])
  @@index([linkedById])
}

model PalletType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  material  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transferLines   PalletTransferLine[]
  movements       PalletMovement[]
  physicalPallets PhysicalPallet[]
}

model PhysicalPallet {
  id                  String               @id @default(uuid())
  palletCode          String               @unique
  palletTypeId        String
  status              PhysicalPalletStatus @default(IN_WAREHOUSE)
  condition           PalletCondition      @default(USABLE)
  currentCustodianId  String?
  currentGatePassId   String?
  currentDOId         String?
  lastMovedAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  palletType       PalletType          @relation(fields: [palletTypeId], references: [id])
  currentCustodian PalletCustodian?    @relation(fields: [currentCustodianId], references: [id])
  currentGatePass  WarehouseGatePass?  @relation("CurrentPalletGatePass", fields: [currentGatePassId], references: [id])
  currentDO        DistributionOrder?  @relation("CurrentPalletDO", fields: [currentDOId], references: [id])
  events           PhysicalPalletEvent[]

  @@index([status, currentCustodianId])
  @@index([palletTypeId])
}

model PhysicalPalletEvent {
  id                  String             @id @default(uuid())
  physicalPalletId    String
  eventType           String
  fromCustodianId     String?
  toCustodianId       String?
  gatePassId          String?
  distributionOrderId String?
  remarks             String?            @db.Text
  recordedById        String
  occurredAt          DateTime           @default(now())

  physicalPallet    PhysicalPallet     @relation(fields: [physicalPalletId], references: [id], onDelete: Cascade)
  fromCustodian     PalletCustodian?   @relation("PhysicalPalletEventFrom", fields: [fromCustodianId], references: [id])
  toCustodian       PalletCustodian?   @relation("PhysicalPalletEventTo", fields: [toCustodianId], references: [id])
  gatePass          WarehouseGatePass? @relation(fields: [gatePassId], references: [id])
  distributionOrder DistributionOrder? @relation(fields: [distributionOrderId], references: [id])
  recordedBy        User               @relation(fields: [recordedById], references: [id])

  @@index([physicalPalletId, occurredAt])
}

model PalletCustodian {
  id                String              @id @default(uuid())
  kind              PalletCustodianKind
  name              String
  externalReference String?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  outgoingTransfers        PalletTransfer[]      @relation("PalletTransferFromCustodian")
  incomingTransfers        PalletTransfer[]      @relation("PalletTransferToCustodian")
  outgoingMovements        PalletMovement[]      @relation("PalletMovementFromCustodian")
  incomingMovements        PalletMovement[]      @relation("PalletMovementToCustodian")
  currentPhysicalPallets   PhysicalPallet[]
  physicalPalletEventsFrom PhysicalPalletEvent[] @relation("PhysicalPalletEventFrom")
  physicalPalletEventsTo   PhysicalPalletEvent[] @relation("PhysicalPalletEventTo")

  @@unique([kind, name])
  @@index([kind, active])
}

model PalletTransfer {
  id                  String               @id @default(uuid())
  transferNo          String               @unique
  status              PalletTransferStatus @default(DRAFT)
  movementType        PalletMovementType
  gatePassId          String?
  distributionOrderId String?
  occurredAt          DateTime
  fromCustodianId     String
  toCustodianId       String
  transportCompany    String?
  driverName          String?
  vehicleNo           String?
  remarks             String?              @db.Text
  evidenceUrl         String?
  releasedSignature   String?              @db.Text
  receivedByName      String?
  receivedSignature   String?              @db.Text
  verifiedSignature   String?              @db.Text
  createdById         String
  verifiedById        String?
  postedById          String?
  postedAt            DateTime?
  reversedById        String?
  reversedAt          DateTime?
  reversalReason      String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  gatePass          WarehouseGatePass?   @relation(fields: [gatePassId], references: [id], onDelete: SetNull)
  distributionOrder DistributionOrder?   @relation(fields: [distributionOrderId], references: [id], onDelete: SetNull)
  fromCustodian     PalletCustodian      @relation("PalletTransferFromCustodian", fields: [fromCustodianId], references: [id])
  toCustodian       PalletCustodian      @relation("PalletTransferToCustodian", fields: [toCustodianId], references: [id])
  createdBy         User                 @relation("PalletTransferCreator", fields: [createdById], references: [id])
  verifiedBy        User?                @relation("PalletTransferVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  postedBy          User?                @relation("PalletTransferPoster", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy        User?                @relation("PalletTransferReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  lines             PalletTransferLine[]
  movements         PalletMovement[]

  @@index([status, occurredAt])
  @@index([gatePassId])
  @@index([distributionOrderId])
  @@index([fromCustodianId])
  @@index([toCustodianId])
}

model PalletTransferLine {
  id            String          @id @default(uuid())
  transferId    String
  palletTypeId  String
  quantity      Int
  fromCondition PalletCondition @default(USABLE)
  toCondition   PalletCondition @default(USABLE)
  remarks       String?         @db.Text

  transfer   PalletTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  palletType PalletType       @relation(fields: [palletTypeId], references: [id])
  movements  PalletMovement[]

  @@index([transferId])
  @@index([palletTypeId])
}

model PalletMovement {
  id                 String             @id @default(uuid())
  transferId         String
  transferLineId     String
  palletTypeId       String
  movementType       PalletMovementType
  fromCustodianId    String
  toCustodianId      String
  quantity           Int
  reversesMovementId String?
  createdById        String
  createdAt          DateTime           @default(now())

  transfer            PalletTransfer     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  transferLine        PalletTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  palletType          PalletType         @relation(fields: [palletTypeId], references: [id])
  fromCustodian       PalletCustodian    @relation("PalletMovementFromCustodian", fields: [fromCustodianId], references: [id])
  toCustodian         PalletCustodian    @relation("PalletMovementToCustodian", fields: [toCustodianId], references: [id])
  reversesMovement    PalletMovement?    @relation("PalletMovementReversal", fields: [reversesMovementId], references: [id])
  reversedByMovements PalletMovement[]   @relation("PalletMovementReversal")
  createdBy           User               @relation("PalletMovementCreator", fields: [createdById], references: [id])

  @@index([transferId])
  @@index([palletTypeId, createdAt])
  @@index([fromCustodianId, palletTypeId])
  @@index([toCustodianId, palletTypeId])
  @@index([reversesMovementId])
}

// ---------------------------------------------------------------------------------------------
// SALES ORDERING OPERATIONS
// ---------------------------------------------------------------------------------------------

model Customer {
  id                    String   @id @default(uuid())
  customerCode          String   @unique
  sageCustomerId        String?
  legalName             String
  tradingName           String?
  pic                   String?
  email                 String?
  phonePrimary          String?
  phoneSecondary        String?
  customerType          String?
  customerSubtype       String?
  categoryCode          String?
  zone                  String?
  region                String?
  creditTermsRaw        String?
  creditTermDays        Int?
  paymentPolicy         String?
  salesRep1             String?
  salesRep2             String?
  companyRegistrationNo String?
  tinNo                 String?
  sstNo                 String?
  importStatus          String   @default("READY")
  sourceData            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  addresses       CustomerAddress[]
  documentIntakes SalesDocumentIntake[]
  salesOrders     SalesOrder[]
  registrations   CustomerRegistration[]

  @@index([sageCustomerId])
  @@index([legalName])
  @@index([customerType, customerSubtype])
  @@index([zone])
}

model CustomerRegistration {
  id                       String  @id @default(uuid())
  registrationNo           String  @unique
  idempotencyKey           String? @unique
  companyName              String
  companyRegNoNew          String?
  companyRegNoOld          String?
  tinNo                    String?
  sstNo                    String?
  businessType             String?
  natureOfBusiness         String?
  businessAddress          String? @db.Text
  registeredAddress        String? @db.Text
  businessCommencementDate String?
  annualTurnover           String?
  paidUpCapital            String?
  contactOffice            String?
  contactFax               String?
  emailInvoice             String?
  msicCode                 String?

  contacts            Json?
  financial           Json?
  tradeReferences     Json?
  directors           Json?
  supportingDocuments Json?
  guarantors          Json?

  status            String    @default("PENDING")
  rejectionReason   String?
  createdCustomerId String?
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdCustomer Customer? @relation(fields: [createdCustomerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([companyName])
  @@index([idempotencyKey])
}

model CustomerAddress {
  id                 String   @id @default(uuid())
  customerId         String
  addressType        String   @default("BILLING")
  label              String   @default("Master Address")
  attentionTo        String?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  addressLine3       String?
  city               String?
  state              String?
  postcode           String?
  country            String?
  fullAddress        String?  @db.Text
  isDefaultBilling   Boolean  @default(true)
  isDefaultDelivery  Boolean  @default(false)
  sourceRowReference String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, label])
  @@index([customerId, addressType])
}

model SalesDocumentIntake {
  id                String    @id @default(uuid())
  fileName          String
  r2ObjectKey       String    @unique
  mimeType          String
  fileSize          Int
  fileHash          String?
  status            String    @default("UPLOADED")
  documentType      String?
  extractedData     Json?
  validationIssues  Json?
  aiModel           String?
  aiProcessedAt     DateTime?
  errorMessage      String?   @db.Text
  matchedCustomerId String?
  uploadedById      String
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  matchedCustomer Customer?   @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)
  uploadedBy      User        @relation("SalesDocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy      User?       @relation("SalesDocumentReviewer", fields: [reviewedById], references: [id])
  salesOrder      SalesOrder?

  @@index([status, createdAt])
  @@index([matchedCustomerId])
  @@index([fileHash])
}

model SalesOrder {
  id                      String    @id @default(uuid())
  internalSoNo            String    @unique
  sageSalesOrderNo        String?
  sourceDocumentId        String?   @unique
  customerId              String
  status                  String    @default("DRAFT")
  documentType            String?
  customerDocumentNo      String?
  poNumber                String?
  orderDate               DateTime? @db.Date
  requestedDeliveryDate   DateTime? @db.Date
  paymentTermsSnapshot    String?
  billingAddressSnapshot  Json?
  deliveryAddressSnapshot Json?
  deliveryContactSnapshot String?
  deliveryPhoneSnapshot   String?
  currency                String    @default("MYR")
  subtotal                Decimal   @default(0) @db.Decimal(14, 2)
  discountTotal           Decimal   @default(0) @db.Decimal(14, 2)
  freightTotal            Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal                Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal              Decimal   @default(0) @db.Decimal(14, 2)
  orderRemarks            String?   @db.Text
  createdById             String
  submittedToWarehouseAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id])
  sourceDocument SalesDocumentIntake? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdBy      User                 @relation("SalesOrderCreator", fields: [createdById], references: [id])
  items          SalesOrderLineItem[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([poNumber])
}

model SalesOrderLineItem {
  id                  String  @id @default(uuid())
  salesOrderId        String
  sku                 String?
  itemCodeSnapshot    String?
  barcodeSnapshot     String?
  descriptionSnapshot String
  uom                 String  @default("CTN")
  qtyOrdered          Decimal @db.Decimal(14, 3)
  qtyAllocated        Decimal @default(0) @db.Decimal(14, 3)
  qtyDelivered        Decimal @default(0) @db.Decimal(14, 3)
  unitPrice           Decimal @default(0) @db.Decimal(14, 4)
  discountAmount      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal @default(0) @db.Decimal(14, 2)
  isServiceCharge     Boolean @default(false)
  remarks             String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([sku])
}

model CreditCheckCase {
  id                  String    @id @default(uuid())
  poFileName          String
  poR2ObjectKey       String    @unique
  soaFileName         String
  soaR2ObjectKey      String    @unique
  status              String    @default("UPLOADED") // UPLOADED, PROCESSING, READY_FOR_SO, ON_HOLD, REJECTED
  recommendation      String?   // APPROVE, HOLD, REJECT
  poData              Json?
  soaData             Json?
  result              Json?
  justification       String?   @db.Text
  financeRemarks      String?   @db.Text
  financeEvidenceUrl  String?
  financeEvidenceName String?
  bdFollowUpRemarks   String?   @db.Text
  finalDecision       String?
  decidedById         String?
  decidedAt           DateTime?
  uploadedById        String
  aiModel             String?
  errorMessage        String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([recommendation, createdAt])
}


// ---------------------------------------------------------------------------------------------
// PEDAS / KBP BATCH
// ---------------------------------------------------------------------------------------------

model PedasBatch {
  id        String   @id @default(uuid())
  sku       String
  batchNo   String   @unique
  qtyPerBag Int      @default(0)
  totalBags Int      @default(1)
  totalQty  Int      @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine        String?
  productCode    String?
  productionDate DateTime? @db.Date
  dayCode        String?
  weekNo         Int?
  weekYear       Int?
  shift          String?

  @@index([productionDate])
  @@index([machine, productionDate, shift])
}

// ---------------------------------------------------------------------------------------------
// Daily Raw Material (Warehouse)
// ---------------------------------------------------------------------------------------------

model WarehouseRawMaterialReport {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  time              String
  shift             String   @default("AM")
  sequence          Int
  preparedBy        String
  preparedSignature String?
  verifiedBy        String?
  verifiedSignature String?
  remarks           String?
  createdById       String?
  linkedDoNumber    String?
  referenceDoNumber String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  status     String    @default("ACTIVE")
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  items WarehouseRawMaterialItem[]

  @@index([date, sequence])
}

model WarehouseRawMaterialItem {
  id           String  @id @default(uuid())
  reportId     String
  sku          String
  category     String
  mult         Int
  batchNo      String
  balanceIn    Float   @default(0)
  qtyIn        Float   @default(0)
  qtyOut       Float   @default(0)
  carryForward Float   @default(0)
  remarks      String?

  report WarehouseRawMaterialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ---------------------------------------------------------------------------------------------
// Raw Material Withdrawal
// ---------------------------------------------------------------------------------------------

model RawMaterialWithdrawal {
  id             String    @id @default(uuid())
  withdrawalNo   String    @unique
  date           DateTime  @db.Date
  time           String
  shift          String    @default("AM")
  takenBy        String
  purpose        String    @default("PRODUCTION")
  remarks        String?
  backdateReason String?
  createdById    String?
  linkedDoNumber String?
  status         String    @default("ACTIVE")
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items RawMaterialWithdrawalItem[]

  @@index([createdAt])
  @@index([date, status])
}

model RawMaterialWithdrawalItem {
  id           String @id @default(uuid())
  withdrawalId String
  sku          String
  category     String
  mult         Int
  batchNo      String
  qty          Float

  withdrawal RawMaterialWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@index([batchNo])
}
